<ui:UXML xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" noNamespaceSchemaLocation="../../UIElementsSchema/UIElements.xsd" editor-extension-mode="False">
    <Style src="project://database/Assets/UI%20Toolkit/HudStyle.uss?fileID=7433441132597879392&amp;guid=bf71bb137adac61419143ecfb9e31e6a&amp;type=3#HudStyle"/>
    <ui:VisualElement name="Container" style="flex-grow: 1;">
        <ui:VisualElement name="Notepad" class="noteOpen noteClosed" style="transition-duration: 0.5s;">
            <ui:VisualElement style="flex-grow: 1; flex-direction: column;">
                <ui:Label text="To do List" name="Header" style="align-self: flex-start; margin-top: 20px; margin-right: 0; margin-bottom: 0; margin-left: 0; padding-top: 0; padding-right: 0; padding-bottom: 0; padding-left: 30px; -unity-text-align: middle-left; font-size: 36px; -unity-font-style: bold; -unity-font-definition: url(&quot;project://database/Assets/UI%20Toolkit/UnityThemes/UnityDefaultRuntimeTheme.tss?fileID=2230732570650464555&amp;guid=fa0aaae680136ef41b02433a7bd1de88&amp;type=3#NotInter-Regular&quot;); border-bottom-width: 2px; width: 500px; border-left-color: rgb(134, 0, 0); border-right-color: rgb(134, 0, 0); border-top-color: rgb(134, 0, 0); border-bottom-color: rgb(134, 0, 0);"/>
                <ui:Label text="Label" name="listLabel_1" class="listLabel" style="border-bottom-color: rgb(0, 0, 0); border-bottom-width: 1px;"/>
                <ui:Label text="Label" name="listLabel_2" class="listLabel" style="border-bottom-width: 1px; border-left-color: rgb(68, 68, 68); border-right-color: rgb(68, 68, 68); border-top-color: rgb(68, 68, 68); border-bottom-color: rgb(68, 68, 68);"/>
                <ui:Label text="Label" name="listLabel_3" class="listLabel" style="border-bottom-color: rgb(58, 58, 58); border-bottom-width: 1px;"/>
                <ui:Label text="Label" name="listLabel_4" class="listLabel" style="border-bottom-width: 1px; border-left-color: rgb(65, 65, 65); border-right-color: rgb(65, 65, 65); border-top-color: rgb(65, 65, 65); border-bottom-color: rgb(65, 65, 65);"/>
                <ui:Label text="Label" name="listLabel_5" class="listLabel" style="border-bottom-width: 1px; border-left-color: rgb(65, 65, 65); border-right-color: rgb(65, 65, 65); border-top-color: rgb(65, 65, 65); border-bottom-color: rgb(65, 65, 65);"/>
            </ui:VisualElement>
            <ui:Button text="V" name="Dropdown" style="align-self: center; align-items: auto; position: relative; width: 180px; font-size: 20px; -unity-text-generator: standard; background-image: url(&quot;project://database/Assets/UI%20Assets/button_1.png?fileID=2800000&amp;guid=85ab32d7c54bf6041824d3026099130f&amp;type=3#button_1&quot;); color: rgb(255, 255, 255); text-shadow: 1987889px 0 0 rgba(0, 0, 0, 0); -unity-text-outline-width: 2px; -unity-text-outline-color: rgb(255, 255, 255); translate: 0 55px; border-top-left-radius: 10px; border-top-right-radius: 10px; border-bottom-right-radius: 10px; border-bottom-left-radius: 10px;"/>
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
