    <ui:VisualElement name="Panel" style="flex-grow: 1; background-image: none; display: flex; opacity: 1;">
        <ui:VisualElement name="Container" style="flex-grow: 1; background-image: none; display: flex; align-self: flex-end; margin-top: 250px; margin-bottom: 0; -unity-text-align: upper-left; align-items: flex-start; flex-direction: column; flex-wrap: nowrap; justify-content: center; width: 547px;">
            <ui:Label text="2Skate" focusable="false" class="header" style="-unity-font-style: bold; -unity-text-outline-color: rgb(255, 227, 225); text-shadow: 5px 5px 40px rgb(255, 107, 86); color: rgb(255, 10, 0); -unity-text-outline-width: 8px; -unity-font-definition: url(&quot;project://database/Assets/UI%20Toolkit/UnityThemes/UnityDefaultRuntimeTheme.tss?fileID=2230732570650464555&amp;guid=fa0aaae680136ef41b02433a7bd1de88&amp;type=3#NotInter-Regular&quot;); font-size: 150px; -unity-text-align: middle-center; align-content: flex-start; flex-direction: column; padding-top: 0; padding-right: 0; padding-bottom: 0; padding-left: 0; margin-left: 0; margin-bottom: 0; margin-right: 0; margin-top: 0; background-color: rgba(0, 0, 0, 0); -unity-background-image-tint-color: rgb(255, 255, 255); -unity-material: url(&quot;&quot;); border-top-left-radius: 0; border-top-right-radius: 0; border-bottom-right-radius: 0; border-bottom-left-radius: 0; -unity-text-auto-size: none; display: none;"/>
            <ui:Button text="Start" parse-escape-sequences="false" name="StartButton" class="button" style="width: 430px; height: 120px; margin-top: 100px; background-image: url(&quot;project://database/Assets/UI%20Assets/button_1.png?fileID=2800000&amp;guid=85ab32d7c54bf6041824d3026099130f&amp;type=3#button_1&quot;); background-color: rgba(188, 188, 188, 0);"/>
            <ui:Button text="Settings" name="SettingsButton" class="button" style="width: 430px; height: 120px; background-image: url(&quot;project://database/Assets/UI%20Assets/button_2.png?fileID=2800000&amp;guid=75c010d44f0733d4f8aa57e1dc6f49d6&amp;type=3#button_2&quot;);"/>
            <ui:Button text="Credits" name="CreditsButton" class="button" style="width: 430px; height: 120px; background-image: url(&quot;project://database/Assets/UI%20Assets/button_3.png?fileID=2800000&amp;guid=1bdcaf1ccff5b1649b82991f92621f4c&amp;type=3#button_3&quot;);"/>
