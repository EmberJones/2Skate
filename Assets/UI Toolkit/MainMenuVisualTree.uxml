<ui:UXML xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" noNamespaceSchemaLocation="../../UIElementsSchema/UIElements.xsd" editor-extension-mode="False">
    <Style src="project://database/Assets/UI%20Toolkit/MainMenuStyle.uss?fileID=7433441132597879392&amp;guid=458909cc42ac6404b9fe1210ba12ec53&amp;type=3#MainMenuStyle"/>
    <ui:VisualElement name="Panel" style="flex-grow: 1; background-image: none; display: flex; opacity: 1; flex-direction: column-reverse; justify-content: flex-start;">
        <ui:VisualElement name="Container" style="flex-grow: 1; background-image: none; display: flex; align-self: flex-end; margin-top: 250px; margin-bottom: 0; -unity-text-align: upper-left; align-items: flex-start; flex-direction: column; flex-wrap: nowrap; justify-content: center; width: 547px; right: 3%;">
            <ui:Label text="2Skate" focusable="false" class="header" style="-unity-font-style: bold; -unity-text-outline-color: rgb(255, 227, 225); text-shadow: 5px 5px 40px rgb(255, 107, 86); color: rgb(255, 10, 0); -unity-text-outline-width: 8px; -unity-font-definition: url(&quot;project://database/Assets/UI%20Toolkit/UnityThemes/UnityDefaultRuntimeTheme.tss?fileID=2230732570650464555&amp;guid=fa0aaae680136ef41b02433a7bd1de88&amp;type=3#NotInter-Regular&quot;); font-size: 150px; -unity-text-align: middle-center; align-content: flex-start; flex-direction: column; padding-top: 0; padding-right: 0; padding-bottom: 0; padding-left: 0; margin-left: 0; margin-bottom: 0; margin-right: 0; margin-top: 0; background-color: rgba(0, 0, 0, 0); -unity-background-image-tint-color: rgb(255, 255, 255); -unity-material: url(&quot;&quot;); border-top-left-radius: 0; border-top-right-radius: 0; border-bottom-right-radius: 0; border-bottom-left-radius: 0; -unity-text-auto-size: none; display: none;"/>
            <ui:Button text="Start" parse-escape-sequences="false" name="StartButton" class="button" style="width: 430px; height: 120px; margin-top: 100px; background-image: url(&quot;project://database/Assets/UI%20Assets/button%205.png?fileID=2800000&amp;guid=c2183bfd5b2b21340a747f1a967f3d0a&amp;type=3#button 5&quot;); background-color: rgba(188, 188, 188, 0); border-top-width: 0; border-right-width: 0; border-bottom-width: 0; border-left-width: 0; -unity-font-definition: url(&quot;project://database/Assets/Fonts/sorean/Sorean%20Bold.otf?fileID=12800000&amp;guid=f2495d34ec526b947bb35dc227aa8087&amp;type=3#Sorean Bold&quot;);"/>
            <ui:Button text="Settings" name="SettingsButton" class="button" style="width: 430px; height: 120px; background-image: url(&quot;project://database/Assets/UI%20Assets/button%203.png?fileID=2800000&amp;guid=fdc00be404c91164ab2e29dec07a8574&amp;type=3#button 3&quot;); border-left-color: rgba(149, 149, 149, 0); border-right-color: rgba(149, 149, 149, 0); border-top-color: rgba(149, 149, 149, 0); border-bottom-color: rgba(149, 149, 149, 0); background-color: rgba(188, 188, 188, 0); border-top-width: 0; border-right-width: 0; border-bottom-width: 0; border-left-width: 0; -unity-font-definition: url(&quot;project://database/Assets/Fonts/sorean/Sorean%20Bold.otf?fileID=12800000&amp;guid=f2495d34ec526b947bb35dc227aa8087&amp;type=3#Sorean Bold&quot;);"/>
            <ui:Button text="How to Play" name="CreditsButton" class="button" style="width: 430px; height: 120px; background-image: url(&quot;project://database/Assets/UI%20Assets/button%202.png?fileID=2800000&amp;guid=083971741c779ee4c844857e3afebb06&amp;type=3#button 2&quot;); background-color: rgba(188, 188, 188, 0); border-top-width: 0; border-right-width: 0; border-bottom-width: 0; border-left-width: 0; -unity-font-definition: url(&quot;project://database/Assets/Fonts/sorean/Sorean%20Bold.otf?fileID=12800000&amp;guid=f2495d34ec526b947bb35dc227aa8087&amp;type=3#Sorean Bold&quot;);"/>
            <ui:Button text="Quit" name="QuitButton" class="button" style="width: 430px; height: 120px; background-image: url(&quot;project://database/Assets/UI%20Assets/button%204.png?fileID=2800000&amp;guid=514ea2cd408725f44847c93d7c0f302b&amp;type=3#button 4&quot;); background-color: rgba(188, 188, 188, 0); border-top-width: 0; border-right-width: 0; border-bottom-width: 0; border-left-width: 0; -unity-font-definition: url(&quot;project://database/Assets/Fonts/sorean/Sorean%20Bold.otf?fileID=12800000&amp;guid=f2495d34ec526b947bb35dc227aa8087&amp;type=3#Sorean Bold&quot;);"/>
        </ui:VisualElement>
        <ui:VisualElement name="CreditsPanel" style="flex-grow: 1; align-self: center; margin-top: 100px; margin-bottom: 100px; visibility: visible; opacity: 1; background-color: rgba(136, 136, 136, 0); width: 1575px; display: none; align-content: stretch; justify-content: flex-start; align-items: center; position: absolute; background-image: url(&quot;project://database/Assets/UI%20Assets/Background.png?fileID=2800000&amp;guid=fee6b20d0fd4911458aeaf8f439ec33c&amp;type=3#Background&quot;); height: 1113px; top: -113px; background-size: 143% 100%;">
            <ui:Label text="How to Play" name="CreditsTitle" class="header" style="color: rgb(255, 255, 255); font-size: 100px; margin-top: 127px; margin-right: 0; margin-bottom: 0; margin-left: 0; padding-top: 0; padding-right: 0; padding-bottom: 0; padding-left: 0; -unity-text-outline-width: 0; top: 20px; -unity-font-definition: url(&quot;project://database/Assets/Fonts/sorean/Sorean%20Bold.otf?fileID=12800000&amp;guid=f2495d34ec526b947bb35dc227aa8087&amp;type=3#Sorean Bold&quot;); -unity-font-style: bold;"/>
            <ui:GroupBox style="flex-direction: row; margin-top: 66px; margin-left: 0; margin-right: 0;">
                <ui:GroupBox style="margin-right: 80px;">
                    <ui:Label text="Objectives" name="Subheading1" class="header" style="font-size: 60px; margin-top: 0; margin-right: 0; margin-bottom: 0; margin-left: 0; padding-top: 0; padding-right: 0; padding-bottom: 0; padding-left: 0; color: rgb(255, 255, 255); text-overflow: ellipsis; -unity-text-outline-width: 0; -unity-text-outline-color: rgba(0, 0, 0, 0.39); -unity-font-style: bold; -unity-font-definition: url(&quot;project://database/Assets/Fonts/sorean/Sorean%20Bold.otf?fileID=12800000&amp;guid=f2495d34ec526b947bb35dc227aa8087&amp;type=3#Sorean Bold&quot;);"/>
                    <ui:Label text="Complete all the tasks given by the Boss before &#10;the end of the shift. &#10;&#10;The items that can be picked up have outlines.&#10;The item&apos;s goals will have an outline showing&#10;where to deliver / take the items.&#10;&#10;- Deliver food from the bar to the correct tables &#10;- Clean the Toilets with the Mop&#10;- Return the roller skates to the storage room&#10;- Throw away trash into the Bin&#10;&#10;And have fun!" name="Body" class="bodytext" style="margin-top: 30px; -unity-font-definition: url(&quot;project://database/Assets/Fonts/sorean/Sorean%20Bold.otf?fileID=12800000&amp;guid=f2495d34ec526b947bb35dc227aa8087&amp;type=3#Sorean Bold&quot;);"/>
                </ui:GroupBox>
                <ui:GroupBox style="margin-left: 80px;">
                    <ui:Label text="Controls" name="Subheading1" class="header" style="font-size: 60px; margin-top: 0; margin-right: 0; margin-bottom: 0; margin-left: 0; padding-top: 0; padding-right: 0; padding-bottom: 0; padding-left: 0; color: rgb(255, 255, 255); -unity-text-outline-width: 0; -unity-text-outline-color: rgba(0, 0, 0, 0.39); -unity-font-definition: url(&quot;project://database/Assets/Fonts/sorean/Sorean%20Bold.otf?fileID=12800000&amp;guid=f2495d34ec526b947bb35dc227aa8087&amp;type=3#Sorean Bold&quot;);"/>
                    <ui:Label text="WASD - Move left foot&#10;&#10;Arrow Keys - Move right foot&#10;&#10;G - Drop Item in hand (Not Food, as thats gross) &#10;&#10;TAB Key -  Drop down the &quot;To do list&quot;&#10;&#10;Escape Key - Pause Menu&#10;&#10;&#10;" name="Body" class="bodytext" style="left: 0; padding-top: 30px; -unity-font-definition: url(&quot;project://database/Assets/Fonts/sorean/Sorean%20Bold.otf?fileID=12800000&amp;guid=f2495d34ec526b947bb35dc227aa8087&amp;type=3#Sorean Bold&quot;);"/>
                </ui:GroupBox>
            </ui:GroupBox>
            <ui:Button text="Back" name="BackButton" class="button" style="-unity-text-align: middle-center; align-content: stretch; justify-content: center; margin-top: 20px; margin-bottom: 20px; width: 430px; height: 120px; background-image: url(&quot;project://database/Assets/UI%20Assets/button%201.png?fileID=2800000&amp;guid=d551e33f293f7c64eacee7a29cce1008&amp;type=3#button 1&quot;); background-color: rgba(188, 188, 188, 0); border-top-width: 0; border-right-width: 0; border-bottom-width: 0; border-left-width: 0; -unity-font-definition: url(&quot;project://database/Assets/Fonts/sorean/Sorean%20Bold.otf?fileID=12800000&amp;guid=f2495d34ec526b947bb35dc227aa8087&amp;type=3#Sorean Bold&quot;);"/>
        </ui:VisualElement>
        <ui:VisualElement style="flex-grow: 1; position: absolute; background-image: url(&quot;project://database/Assets/UI%20Assets/button%201.png?fileID=2800000&amp;guid=d551e33f293f7c64eacee7a29cce1008&amp;type=3#button 1&quot;); width: 630px; height: 155px; padding-top: 40px; padding-left: 40px; padding-right: 40px; padding-bottom: 40px; -unity-text-align: middle-center; align-self: center; justify-content: center; top: 1%; left: 0%;">
            <ui:Label text="For the best experience play the downloadable version!" style="font-size: 32px; -unity-font-definition: url(&quot;project://database/Assets/Fonts/sorean/Sorean%20Bold.otf?fileID=12800000&amp;guid=f2495d34ec526b947bb35dc227aa8087&amp;type=3#Sorean Bold&quot;); color: rgb(255, 255, 255); -unity-text-align: middle-center; white-space: pre-wrap;"/>
        </ui:VisualElement>
    </ui:VisualElement>
