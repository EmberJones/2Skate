        </ui:VisualElement>
        <ui:VisualElement name="CreditsPanel" style="flex-grow: 1; align-self: center; margin-top: 100px; margin-bottom: 100px; visibility: visible; opacity: 1; background-color: rgb(136, 136, 136); width: 650px; display: none; align-content: stretch; justify-content: flex-start; align-items: center; position: absolute;">
            <ui:Label text="Credits" name="CreditsTitle" class="header" style="color: rgb(255, 255, 255); font-size: 150px; margin-top: 0; margin-right: 0; margin-bottom: 0; margin-left: 0; padding-top: 0; padding-right: 0; padding-bottom: 0; padding-left: 0;"/>
            <ui:Label text="Programmers" name="Subheading1" class="header" style="font-size: 50px; margin-top: 0; margin-right: 0; margin-bottom: 0; margin-left: 0; padding-top: 0; padding-right: 0; padding-bottom: 0; padding-left: 0;"/>
