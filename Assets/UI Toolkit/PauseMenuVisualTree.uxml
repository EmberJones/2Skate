<ui:UXML xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" noNamespaceSchemaLocation="../../UIElementsSchema/UIElements.xsd" editor-extension-mode="False">
    <Style src="project://database/Assets/UI%20Toolkit/MainMenuStyle.uss?fileID=7433441132597879392&amp;guid=458909cc42ac6404b9fe1210ba12ec53&amp;type=3#MainMenuStyle"/>
    <ui:VisualElement name="PauseContainer" style="flex-grow: 1; align-items: center; flex-wrap: wrap; display: none;">
        <ui:VisualElement name="Actions" style="flex-grow: 1; padding-bottom: 0; margin-top: 0; -unity-text-align: middle-center; background-color: rgba(136, 26, 26, 0); border-top-left-radius: 30px; border-top-right-radius: 30px; border-bottom-right-radius: 30px; border-bottom-left-radius: 30px; margin-bottom: 0; align-items: center; justify-content: center; width: 1400px; height: 1000px; flex-direction: column; position: absolute; top: 23px; align-self: center; background-image: url(&quot;project://database/Assets/UI%20Assets/Background.png?fileID=2800000&amp;guid=fee6b20d0fd4911458aeaf8f439ec33c&amp;type=3#Background&quot;);">
            <ui:Label text="Paused" class="header" style="margin-top: 0; margin-right: 0; margin-bottom: 0; margin-left: 0; padding-top: 0; padding-right: 0; padding-bottom: 0; padding-left: 0; top: 0; align-self: center; color: rgb(255, 255, 255); -unity-text-align: upper-center; position: relative; left: auto; align-items: center; -unity-text-outline-width: 8px; -unity-text-outline-color: rgba(0, 0, 0, 0.36);"/>
            <ui:Button text="Resume" name="ResumeButton" class="button" style="margin-right: 0; margin-bottom: 0; margin-left: 0; margin-top: 80px; background-image: url(&quot;project://database/Assets/UI%20Assets/button_1.png?fileID=2800000&amp;guid=85ab32d7c54bf6041824d3026099130f&amp;type=3#button_1&quot;); width: 440px;"/>
            <ui:Button text="Settings" name="SettingsButton" class="button" style="margin-right: 0; margin-bottom: 0; margin-left: 0; background-image: url(&quot;project://database/Assets/UI%20Assets/button_2.png?fileID=2800000&amp;guid=75c010d44f0733d4f8aa57e1dc6f49d6&amp;type=3#button_2&quot;); width: 440px;"/>
            <ui:Button text="Main Menu" name="MainMenuButton" class="button" style="margin-right: 0; margin-bottom: 0; margin-left: 0; background-image: url(&quot;project://database/Assets/UI%20Assets/button_3.png?fileID=2800000&amp;guid=1bdcaf1ccff5b1649b82991f92621f4c&amp;type=3#button_3&quot;); width: 440px;"/>
        </ui:VisualElement>
