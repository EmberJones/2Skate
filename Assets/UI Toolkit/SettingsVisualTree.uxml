<ui:UXML xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" noNamespaceSchemaLocation="../../UIElementsSchema/UIElements.xsd" editor-extension-mode="False">
    <Style src="project://database/Assets/UI%20Toolkit/MainMenuStyle.uss?fileID=7433441132597879392&amp;guid=458909cc42ac6404b9fe1210ba12ec53&amp;type=3#MainMenuStyle"/>
    <ui:VisualElement name="SettingsContainer" style="flex-grow: 1;">
        <ui:VisualElement name="BackGround" style="flex-grow: 1; background-color: rgb(109, 55, 55); align-self: center; width: 1800px; flex-direction: row; justify-content: center; align-items: center; margin-top: 40px; margin-bottom: 40px; position: absolute; height: 1000px; top: auto;">
            <ui:VisualElement name="actions" style="flex-grow: 1; align-self: flex-end; flex-direction: row; justify-content: center; align-items: center; margin-bottom: 20px; position: absolute; bottom: 20px;">
                <ui:Button text="Apply" view-data-key="" name="ApplyButton" class="button" style="right: 20px;"/>
                <ui:Button text="Back" name="SettingsBackButton" class="button" style="left: 20px;"/>
            </ui:VisualElement>
            <ui:VisualElement name="Settings" style="flex-grow: 1; align-self: flex-start; align-items: auto; flex-direction: column; height: 797px; justify-content: center; left: auto; top: auto; flex-wrap: wrap; position: relative;">
                <ui:DropdownField label="Display Resolution" enabled="true" name="ResolutionDropdown" class="button" style="width: 1500px; justify-content: flex-start; align-self: center; flex-direction: row; margin-right: 0; margin-bottom: 0; margin-left: 0; flex-wrap: nowrap; margin-top: 50px; -unity-text-align: middle-center; align-items: stretch; align-content: auto; white-space: normal;"/>
                <ui:DropdownField label="Quality&#10;" enabled="true" name="QualityDropdown" language-direction="Inherit" class="button" style="width: 1500px; justify-content: flex-start; align-self: center; flex-direction: row; margin-right: 0; margin-bottom: 0; margin-left: 33px; flex-wrap: nowrap; margin-top: 50px; -unity-text-align: middle-center; align-items: stretch; align-content: auto; position: relative; top: auto; left: auto; -unity-text-auto-size: none; aspect-ratio: auto; text-overflow: clip; white-space: normal; -unity-font-style: normal; -unity-slice-type: sliced;"/>
                <ui:Slider label="Master Volume" value="100" high-value="1" name="VolumeSlider" tabindex="0" picking-mode="Ignore" class="button" style="width: 1400px; height: 200px; align-self: center; align-items: center; align-content: auto; -unity-font-style: normal; background-color: rgba(0, 0, 0, 0); font-size: 40px; margin-top: 0; -unity-paragraph-spacing: 0; text-overflow: clip; -unity-text-align: middle-left; overflow: visible; visibility: visible; position: relative;"/>
                <ui:Toggle label="Full Screen" name="FullScreen" class="button" style="align-self: center; justify-content: flex-end; flex-wrap: wrap-reverse; flex-direction: row; align-content: auto; align-items: center; -unity-text-align: lower-left; white-space: normal; font-size: 40px; margin-top: 0; margin-right: 0; margin-bottom: 0; margin-left: 0; border-top-left-radius: 0; border-top-right-radius: 0; border-bottom-right-radius: 0; border-bottom-left-radius: 0; scale: 1 1; -unity-slice-type: sliced; -unity-background-scale-mode: stretch-to-fill; background-position-y: center; background-position-x: center; flex-shrink: 0; -unity-font-style: normal;"/>
            </ui:VisualElement>
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
