:root {
}

.listLabel {
    font-size: 24px;
    margin-top: 50px;
    margin-left: 0;
    padding-left: 50px;
    margin-right: -1px;
    border-bottom-width: 1px;
    border-left-color: rgb(89, 89, 89);
    border-right-color: rgb(89, 89, 89);
    border-top-color: rgb(89, 89, 89);
    border-bottom-color: rgb(89, 89, 89);
    -unity-font-definition: url("project://database/Assets/Fonts/sorean/Sorean%20Bold.otf?fileID=12800000&guid=f2495d34ec526b947bb35dc227aa8087&type=3#Sorean Bold");
}

.noteOpen {
    flex-grow: 1;
    align-self: flex-start;
    min-width: 500px;
    width: 500px;
    height: 500px;
    min-height: 565px;
    max-height: 600px;
    max-width: 600px;
    background-color: rgb(217, 212, 134);
    margin-top: 20px;
    background-image: url("project://database/Assets/UI%20Assets/MainWallTexture3.png?fileID=21300000&guid=e07abdbe4ae863f46980639d9e8a8fe7&type=3#MainWallTexture3");
    -unity-background-image-tint-color: rgba(250, 255, 178, 0.4);
    flex-direction: column;
    margin-left: 20px;
    align-items: center;
}

.noteClosed {
    translate: 0 -625px;
}

.objective-complete {
    color: rgb(92, 182, 102);
    -unity-font-style: bold-and-italic;
    font-size: 24px;
}

.game-over-text {
    -unity-text-align: upper-center;
    font-size: 80px;
    -unity-font-style: bold;
    -unity-font-definition: url("project://database/Assets/Fonts/sorean/Sorean%20Bold.otf?fileID=12800000&guid=f2495d34ec526b947bb35dc227aa8087&type=3#Sorean Bold");
    border-right-width: 20px;
    border-left-width: 20px;
    text-shadow: 5px 5px 0 rgb(0, 0, 0);
    color: rgb(255, 255, 255);
}

.GameNotOver {
    flex-grow: 1;
    flex-direction: row;
    align-self: center;
    width: 800px;
    align-items: center;
    align-content: flex-start;
    justify-content: center;
    position: relative;
    opacity: 1;
    translate: 0 1300px;
}

.GameOver {
    translate: 0 600px;
    scale: 1.1 1.1;
    color: rgb(201, 36, 36);
}

.GameNotWon {
    flex-grow: 1;
    flex-direction: row;
    align-self: center;
    width: 800px;
    align-items: center;
    align-content: flex-start;
    justify-content: center;
    translate: 0 -300px;
}

.GameWon {
    scale: 1.1 1.1;
    translate: 0 400px;
}
